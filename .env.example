# Copy to .env before `docker compose up`. Two keys are required, for two
# different providers - see the README for why.

# Claude: synthesis, the route classifier, the relevance grader, HyDE.
ANTHROPIC_API_KEY=your_key_here

# OpenAI: embeddings only (text-embedding-3-small). Required to index documents
# at sync time and to embed queries at retrieval time. This is a separate
# provider on purpose - it is the one call that is not a chat completion.
OPENAI_API_KEY=your_key_here

# Signing key for dev-login tokens. Identity is read from the verified token,
# so this is the whole trust boundary. Change it for anything but a local demo.
JWT_SECRET=dev-secret-not-for-production

ENVIRONMENT=development
MAX_TOKENS=4096

# Optional: a static API key gate in front of /api/*, on top of the per-user
# token. Left empty, the gate is disabled.
PLATFORM_API_KEY=

# --- normally left alone -----------------------------------------------------
# compose sets these; listed so a non-Docker run knows what to provide.
# DATA_DIR=data
# S3_ENDPOINT_URL=http://localstack:4566
# EMBEDDING_PROVIDER=openai   # 'hash' is a deterministic offline provider for
#                             # tests only; it must never be set in a real run.
