# Shell scripts must keep LF endings even when checked out on Windows
# (core.autocrlf=true would otherwise rewrite the shebang to "#!/usr/bin/env bash\r",
# which bash rejects with "bad interpreter").
*.sh text eol=lf

# The corpus is content-addressed: files are deduplicated by the sha256 of
# their bytes, so git must not rewrite line endings underneath them or the
# same document would hash differently on Windows and Linux.
corpus/** -text
